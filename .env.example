# Copy to .env only if you need to change something. Every value has a default.

# Your computer's LAN IP, so the log prints a URL the iPad can open.
# macOS: ipconfig getifaddr en0    Linux: hostname -I
DECK_URL_HOST=

# Write the deck's hooks into ~/.claude/settings.json on start (a backup is kept
# at settings.json.bak-deck). Set to false to manage hooks yourself.
DECK_INSTALL_HOOKS=true

# Linux: your user, so the container can edit ~/.claude/settings.json (id -u / id -g).
DECK_UID=1000
DECK_GID=1000

# Host ports.
DECK_UI_HOST_PORT=8787
DECK_HOOK_HOST_PORT=8788

# Seconds to hold a permission / a question before handing it back to the desktop.
DECK_PERM_TIMEOUT=90
DECK_QUESTION_TIMEOUT=300
